---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import heroPhoto from '../../../images/optimized/hero-patient-chair.webp';
import { site } from '../../data/site';
---
<section class="hero bloom bloom--fade" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <figure class="hero__frame">
      <Image
        src={heroPhoto}
        alt="A smiling patient with long dark hair seated in a dental chair at Smile Precision, beside the clinic’s chairside monitor"
        widths={[480, 760, 1090]}
        sizes="(min-width: 1024px) min(58vw, 760px), 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
        data-intro="focus"
        data-parallax
      />
    </figure>

    <div class="hero__copy">
      <p class="eyebrow" data-intro style="--d: 150ms">Cosmetic dentistry · San Fernando, Pampanga</p>
      <h1 class="hero__title display" id="hero-title" data-intro style="--d: 300ms">
        Veneers crafted around your <span class="accent">smile</span>
      </h1>
      <p class="hero__lede" data-intro style="--d: 480ms">
        Minimal-prep veneers, laser whitening and gentle everyday care by {site.dentist}, on MacArthur Highway.
      </p>
      <a class="btn btn--white hero__cta" href={site.bookingUrl} data-intro style="--d: 640ms">
        Book your appointment
        <span class="btn__chip"><Icon name="arrow" /></span>
      </a>
    </div>

    <dl class="hero__stats glass-strong" data-intro style="--d: 820ms">
      {site.stats.map((s, i) => (
        <div class="hero__stat" data-intro style={`--d: ${1000 + i * 140}ms`}>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding: 92px 0 var(--space-7);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-5);
  }

  /* mobile first: photo runs edge to edge at the top, copy and stats below */
  .hero__frame {
    background: var(--mist);
    margin: 0 calc(-1 * var(--gutter));
    margin-top: -92px;
    position: relative;
    aspect-ratio: 4 / 3.6;
    overflow: hidden;
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  }
  .hero__frame::after {
    /* a soft wash at the top so the floating nav reads over the TV and equipment */
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 30%;
    background: linear-gradient(rgba(232, 245, 248, 0.55), transparent);
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 40%;
    /* rests slightly enlarged so the scroll parallax (translate, set in BaseLayout) never shows an edge */
    scale: 1.08;
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }
  .hero__title {
    font-size: var(--text-hero);
    max-width: 11ch;
  }
  .hero__lede {
    font-size: var(--text-md);
    color: var(--ink-soft);
    max-width: 40ch;
  }
  .hero__cta { margin-top: var(--space-2); }

  /* frosted proof bar: four numbers, separated by space only */
  .hero__stats {
    margin: var(--space-3) 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5) var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
  }
  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
  }
  .hero__stat dd {
    margin: 0;
    font: 300 var(--text-stat)/1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .hero__stat dt {
    font-size: var(--text-xs);
    line-height: 1.35;
    color: var(--ink-soft);
  }

  @media (min-width: 640px) {
    .hero__frame { aspect-ratio: 16 / 10; }
  }

  /* desktop: photo framed on the right (never wider than its native 1090px), headline in the open left,
     proof bar floating across the bottom edge of the photo */
  @media (min-width: 1024px) {
    .hero {
      padding: 112px 0 var(--space-8);
      min-height: min(100svh, 940px);
      display: flex;
      align-items: center;
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      gap: 0 var(--space-5);
      align-items: center;
    }
    .hero__frame {
      grid-column: 6 / -1;
      grid-row: 1;
      margin: 0;
      aspect-ratio: 1090 / 633;
      max-width: 1090px;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-float);
    }
    .hero__frame::after { display: none; }
    .hero__img { object-position: 60% 50%; }
    .hero__copy {
      grid-column: 1 / 7;
      grid-row: 1;
      z-index: 2;
      padding: 0 0 var(--space-7);
    }
    .hero__stats {
      grid-column: 4 / -1;
      grid-row: 2;
      z-index: 3;
      margin: -84px var(--space-6) 0 0;
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
      padding: var(--space-5) var(--space-7);
      border-radius: var(--radius-lg);
    }
    .hero__stat { align-items: center; text-align: center; }
    .hero__stat dt { max-width: 15ch; }
  }
  @media (min-width: 1024px) and (max-width: 1199px) {
    .hero__copy { grid-column: 1 / 8; }
    .hero__stats { grid-column: 2 / -1; padding-inline: var(--space-6); }
  }
</style>
