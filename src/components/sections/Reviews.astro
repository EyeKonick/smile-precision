---
import Icon from '../ui/Icon.astro';
import data from '../../data/testimonials.json';
import { site } from '../../data/site';
---
<section class="rev section" id="reviews" aria-labelledby="rev-title">
  <div class="container">
    <div class="rev__panel glass" data-reveal>
      <div class="rev__score">
        <p class="eyebrow">What patients say</p>
        <h2 class="sr-only" id="rev-title">Patient reviews</h2>
        <p class="rev__big"><span>{data.summary.value}</span></p>
        <p class="rev__label">{data.summary.label}</p>
        <p class="rev__src">{data.summary.source}</p>
        <a class="btn btn--ink" href={site.facebookUrl} target="_blank" rel="noopener">
          Read them on Facebook<span class="btn__chip"><Icon name="arrow-up-right" /></span>
        </a>
      </div>

      <ul class="rev__list" data-stagger>
        {data.reviews.map((r) => (
          <li class:list={['rev__card lift sheen', { 'rev__card--ph': r.placeholder }]} data-reveal>
            {r.placeholder && <span class="rev__flag">Review placeholder</span>}
            <blockquote>“{r.quote}”</blockquote>
            <p class="rev__who"><strong>{r.name}</strong> · {r.treatment}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .rev { position: relative; isolation: isolate; }
  .rev::before {
    content: '';
    position: absolute;
    inset: 12% 0;
    z-index: -1;
    background:
      radial-gradient(35% 60% at 20% 50%, rgba(13, 169, 224, 0.35), transparent 70%),
      radial-gradient(40% 70% at 85% 40%, rgba(159, 214, 217, 0.8), transparent 70%);
  }
  .rev__panel {
    display: grid;
    gap: var(--space-7);
    padding: clamp(24px, 5vw, 64px);
    border-radius: var(--radius-xl);
  }
  .rev__score { display: grid; gap: var(--space-2); justify-items: start; align-content: start; }
  .rev__big {
    font: 200 clamp(4.5rem, 2rem + 9vw, 9rem)/0.9 var(--font-display);
    letter-spacing: -0.04em;
    margin-top: var(--space-3);
  }
  .rev__label { font: 600 var(--text-lg)/1.2 var(--font-display); }
  .rev__src { color: var(--ink-soft); font-size: var(--text-sm); margin-bottom: var(--space-4); }
  .rev__list { display: grid; gap: var(--space-4); }
  .rev__card {
    position: relative;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--glass-edge);
  }
  .rev__card--ph { border: 1.5px dashed var(--seafoam); background: rgba(255, 255, 255, 0.5); }
  .rev__flag {
    display: inline-block;
    margin-bottom: var(--space-2);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--mist);
    font: 600 0.6875rem/1.6 var(--font-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }
  blockquote { margin: 0; font: 500 var(--text-md)/1.5 var(--font-display); }
  .rev__card--ph blockquote { color: var(--ink-soft); }
  .rev__who { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--ink-soft); }
  .rev__who strong { color: var(--ink); }

  @media (min-width: 1024px) {
    .rev__panel { grid-template-columns: 4fr 7fr; align-items: center; }
  }
</style>
