---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import logo from '../../../images/optimized/logo.png';
import { site, nav } from '../../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---
<header class="hdr" data-hdr>
  <div class="hdr__bar">
    <a class="hdr__brand glass-strong" href="/" aria-label={`${site.legalName}, home`}>
      <Image src={logo} alt="" widths={[150, 300]} sizes="150px" loading="eager" class="hdr__logo" />
    </a>

    <nav class="hdr__nav glass" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__contact glass">
      <a href={`tel:${site.phone.tel}`}><span>{site.phone.display}</span><Icon name="phone" /></a>
      <a href={`mailto:${site.email}`}><span>{site.email}</span><Icon name="mail" /></a>
    </div>

    <button class="hdr__toggle glass-strong" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <Icon name="menu" />
      <span>Menu</span>
    </button>
  </div>

  <div class="hdr__sheet glass-strong" id="menu" hidden data-menu>
    <nav aria-label="Main (mobile)">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              <Icon name="arrow" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__sheet-actions">
      <a class="btn btn--ink" href={site.bookingUrl}>Book your appointment<span class="btn__chip"><Icon name="arrow" /></span></a>
      <a class="hdr__sheet-call" href={`tel:${site.phone.tel}`}><Icon name="phone" />{site.phone.display}</a>
    </div>
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const sheet = document.querySelector<HTMLElement>('[data-menu]');

  if (hdr) {
    const onScroll = () => hdr.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && sheet) {
    const label = toggle.querySelector('span');
    const setOpen = (open: boolean, focusToggle = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      sheet.hidden = !open;
      if (label) label.textContent = open ? 'Close' : 'Menu';
      if (open) sheet.querySelector<HTMLAnchorElement>('a')?.focus();
      else if (focusToggle) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !sheet.hidden) setOpen(false, true);
    });
    sheet.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !sheet.contains(next) && next !== toggle) setOpen(false);
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (m) => m.matches && setOpen(false));
  }
</script>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    padding: max(14px, env(safe-area-inset-top)) var(--gutter) 0;
    pointer-events: none;
  }
  .hdr__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 1400px;
    margin-inline: auto;
  }
  .hdr__bar > *,
  .hdr__sheet { pointer-events: auto; }

  .hdr__brand {
    display: flex;
    align-items: center;
    height: 52px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
  }
  .hdr__logo { width: 150px; height: auto; }

  /* centred glass pill nav; the current page sits in a deeper glass capsule */
  .hdr__nav {
    display: none;
    border-radius: var(--radius-pill);
    padding: 5px;
  }
  .hdr__nav ul { display: flex; gap: 2px; }
  .hdr__nav a {
    display: block;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    font: 500 0.9375rem/1.2 var(--font-display);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--dur-hover) var(--ease);
  }
  .hdr__nav a:hover { background: rgba(255, 255, 255, 0.7); }
  .hdr__nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--white);
  }

  .hdr__contact {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    padding: 8px 16px;
    border-radius: var(--radius-md);
  }
  .hdr__contact a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 var(--text-xs)/1.3 var(--font-text);
    color: var(--ink);
    text-decoration: none;
  }
  .hdr__contact a:hover span { text-decoration: underline; }
  .hdr__contact :global(svg) { width: 14px; height: 14px; color: var(--brand-deep); }

  .hdr__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 52px;
    padding: 0 20px 0 16px;
    border-radius: var(--radius-pill);
    color: var(--ink);
    font: 600 0.9375rem/1 var(--font-display);
    cursor: pointer;
  }
  .hdr__toggle :global(svg) { width: 20px; height: 20px; }

  .hdr__sheet {
    margin-top: var(--space-3);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    max-width: 520px;
    margin-left: auto;
    animation: sheet-in 360ms var(--ease) both;
  }
  .hdr__sheet[hidden] { display: none; }
  .hdr__sheet ul { display: grid; }
  .hdr__sheet li + li { border-top: 1px solid var(--line); }
  .hdr__sheet nav a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    padding: 0 var(--space-3);
    font: 600 1.25rem/1 var(--font-display);
    text-decoration: none;
    color: var(--ink);
  }
  .hdr__sheet nav a :global(svg) { width: 20px; height: 20px; color: var(--brand-deep); }
  .hdr__sheet nav a[aria-current='page'] { color: var(--brand-deep); }
  .hdr__sheet-actions {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-4) var(--space-3) var(--space-3);
  }
  .hdr__sheet-call {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px;
    font-weight: 600; color: var(--ink); text-decoration: none;
  }
  .hdr__sheet-call :global(svg) { width: 18px; height: 18px; color: var(--brand-deep); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(-8px); } }

  /* once the page scrolls, the glass thickens so text stays legible over photos */
  .hdr.is-scrolled .hdr__nav,
  .hdr.is-scrolled .hdr__contact { background: var(--glass-strong); }

  @media (min-width: 900px) {
    .hdr__nav { display: block; }
    .hdr__toggle, .hdr__sheet { display: none !important; }
  }
  @media (min-width: 1180px) {
    .hdr__contact { display: flex; }
  }
  @media (max-width: 899px) {
    .hdr__brand { height: 48px; padding: 0 14px; }
    .hdr__logo { width: 128px; }
    .hdr__toggle { height: 48px; }
  }
</style>
