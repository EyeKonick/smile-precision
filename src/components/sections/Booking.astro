---
import Icon from '../ui/Icon.astro';
import AppointmentForm from '../ui/AppointmentForm.astro';
import { site } from '../../data/site';

interface Props {
  title?: string;
  accent?: string;
  headingLevel?: 'h1' | 'h2';
}
const { title = 'Your new smile starts with a', accent = 'visit', headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---
<section class="book bloom section" id="book" aria-labelledby="book-title">
  <div class="container book__grid">
    <div class="book__intro" data-reveal>
      <p class="eyebrow">Book an appointment</p>
      <H class="display book__title" id="book-title">{title}{' '}<span class="accent">{accent}</span></H>
      <p class="lede">
        Send your preferred day and we’ll confirm by text or Messenger. Not sure what you need? Choose a consultation.
      </p>

      <ul class="book__ways" data-stagger>
        <li data-reveal>
          <a class="book__way glass" href={`tel:${site.phone.tel}`}>
            <span class="book__icon"><Icon name="phone" /></span>
            <span><small>Call or text</small>{site.phone.display}</span>
          </a>
        </li>
        <li data-reveal>
          <a class="book__way glass" href={site.messengerUrl} target="_blank" rel="noopener">
            <span class="book__icon"><Icon name="messenger" /></span>
            <span><small>Message us</small>Facebook Messenger</span>
          </a>
        </li>
        <li data-reveal>
          <a class="book__way glass" href={site.mapsUrl} target="_blank" rel="noopener">
            <span class="book__icon"><Icon name="pin" /></span>
            <span><small>{site.address.unit}, {site.address.building}</small>{site.address.street}, San Fernando</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="book__card glass-strong" data-reveal>
      <AppointmentForm />
    </div>
  </div>
</section>

<style>
  .book__grid { display: grid; gap: var(--space-7); align-items: start; }
  .book__intro { display: grid; gap: var(--space-4); justify-items: start; }
  .book__title { font-size: var(--text-xl); max-width: 13ch; }
  .book__ways { display: grid; gap: var(--space-3); width: 100%; margin-top: var(--space-3); }
  .book__way {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 12px 18px 12px 12px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font: 600 var(--text-base)/1.25 var(--font-display);
    transition: translate var(--dur-hover) var(--ease);
  }
  .book__way small {
    display: block;
    font: 500 var(--text-xs)/1.3 var(--font-text);
    color: var(--ink-soft);
  }
  .book__icon {
    display: grid; place-items: center; flex: none;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--ink); color: var(--white);
  }
  .book__icon :global(svg) { width: 18px; height: 18px; }
  @media (hover: hover) and (pointer: fine) { .book__way:hover { translate: 4px 0; } }
  .book__card {
    padding: clamp(20px, 3vw, 40px);
    border-radius: var(--radius-lg);
  }
  @media (min-width: 1024px) {
    .book__grid { grid-template-columns: 0.85fr 1.15fr; gap: var(--space-8); }
    .book__intro { position: sticky; top: 120px; }
  }
</style>
