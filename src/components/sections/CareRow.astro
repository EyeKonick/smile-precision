---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import whitening from '../../../images/optimized/whitening-strip.webp';
import servicesData from '../../data/services.json';

const care = servicesData.services.filter((s) => s.category !== 'veneers');
const [lead, ...others] = care;
type IconName = Parameters<typeof Icon>[0]['name'];
---
<section class="care section bloom" aria-labelledby="care-title">
  <div class="container">
    <header class="care__head" data-reveal>
      <h2 class="display h2" id="care-title">Beyond veneers, the same <span class="accent">care</span></h2>
      <p class="lede">Whitening, makeovers and the everyday dentistry that keeps every smile healthy underneath.</p>
    </header>

    <ul class="care__track" data-stagger aria-label="Other treatments">
      <li class="care__card care__card--lead glass-strong lift sheen" data-reveal>
        <div class="care__photo zoom">
          <Image src={whitening} alt="Three patients mid-treatment during laser whitening, with a blue protective barrier along the gums" widths={[453, 906]} sizes="(min-width: 1024px) 460px, 85vw" loading="lazy" />
        </div>
        <div class="care__text">
          <h3>{lead.name}</h3>
          <p>{lead.description}</p>
          <a class="text-link" href={`/services#${lead.slug}`}><span>Learn more</span><Icon name="arrow" /></a>
        </div>
      </li>
      {others.map((s) => (
        <li class="care__card glass lift sheen" data-reveal>
          <span class="care__icon"><Icon name={s.icon as IconName} /></span>
          <h3>{s.name}</h3>
          <p>{s.description}</p>
          <a class="care__more" href={`/services#${s.slug}`} aria-label={`More about ${s.name}`}><Icon name="arrow-up-right" /></a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .care__head { display: grid; gap: var(--space-4); margin-bottom: var(--space-7); }
  .care__head .h2 { max-width: 16ch; }

  /* horizontal, snap-scrolling row; it wraps into a grid on wide screens */
  .care__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 300px);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 4px var(--gutter) var(--space-4);
    margin-inline: calc(-1 * var(--gutter));
    scrollbar-width: thin;
  }
  .care__card {
    position: relative;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
  }
  .care__card h3 { font-size: var(--text-lg); }
  .care__card p { font-size: var(--text-sm); color: var(--ink-soft); }
  .care__icon {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: var(--white); color: var(--brand-deep); margin-bottom: var(--space-3);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .care__icon :global(svg) { width: 24px; height: 24px; }
  .care__more {
    margin-top: auto;
    align-self: flex-end;
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--ink); color: var(--white);
  }
  .care__more :global(svg) { width: 18px; height: 18px; }
  .care__card--lead { padding: var(--space-3); grid-row: span 1; }
  .care__card--lead .care__text { display: grid; gap: var(--space-3); padding: var(--space-3); justify-items: start; }
  .care__photo { border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 906 / 194; }
  .care__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 1024px) {
    .care__head { grid-template-columns: 1fr 1fr; align-items: end; }
    .care__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      overflow: visible;
      padding: 0;
      margin: 0;
    }
    .care__card--lead { grid-column: span 2; }
  }
</style>
