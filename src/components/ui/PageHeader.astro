---
// Inner-page header: big all-caps title on an aqua bloom, with an optional framed photo.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  focus?: string;
}
const { eyebrow, title, accent, lede, image, imageAlt = '', focus = '50% 50%' } = Astro.props;
---
<section class:list={['ph-head bloom bloom--fade', { 'ph-head--photo': image }]}>
  <div class="container ph-head__grid">
    <div class="ph-head__copy">
      <p class="eyebrow" data-intro style="--d: 100ms">{eyebrow}</p>
      <h1 class="display ph-head__title" data-intro style="--d: 240ms">{title}{' '}<span class="accent">{accent}</span></h1>
      {lede && <p class="lede" data-intro style="--d: 400ms">{lede}</p>}
      <div class="ph-head__slot" data-intro style="--d: 540ms"><slot /></div>
    </div>
    {image && (
      <figure class="ph-head__frame">
        <Image src={image} alt={imageAlt} widths={[480, 760, image.width]} sizes="(min-width: 1024px) 560px, 100vw" loading="eager" style={`object-position: ${focus}; --d: 120ms`} data-intro="focus" />
      </figure>
    )}
  </div>
</section>

<style>
  .ph-head { padding: 132px 0 var(--space-8); }
  .ph-head__grid { display: grid; gap: var(--space-6); align-items: end; }
  .ph-head__copy { display: grid; gap: var(--space-4); justify-items: start; }
  .ph-head__title { font-size: clamp(2.5rem, 1.4rem + 4.2vw, 4.75rem); max-width: 14ch; }
  .ph-head__frame {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--mist);
    box-shadow: var(--shadow-float);
  }
  .ph-head__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ph-head__slot:empty { display: none; }
  @media (min-width: 1024px) {
    .ph-head--photo .ph-head__grid { grid-template-columns: 1.1fr 0.9fr; }
    .ph-head--photo .ph-head__copy { padding-bottom: var(--space-6); }
  }
</style>
