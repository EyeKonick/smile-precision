---
// One stroke icon set (24px grid, 2px stroke) used everywhere on the site.
interface Props {
  name:
    | 'phone' | 'calendar' | 'messenger' | 'pin' | 'mail' | 'facebook' | 'directions' | 'arrow' | 'clock'
    | 'check' | 'search' | 'shield' | 'extract' | 'align' | 'replace' | 'sun'
    | 'chat' | 'send' | 'close'
    | 'diamond' | 'layers' | 'tooth' | 'sparkle' | 'smile' | 'drop' | 'instagram' | 'menu' | 'arrow-up-right' | 'star';
  class?: string;
}
const { name, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
