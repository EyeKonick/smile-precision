  layers: '<path d="m12 2 10 5-10 5L2 7z"/><path d="m2 12 10 5 10-5"/><path d="m2 17 10 5 10-5"/>',
  tooth: '<path d="M7 3c-2.5 0-4 2-4 5 0 2.5 1 4 1.5 6 .6 2.6 1 7 3 7 1.7 0 1.7-5 4.5-5s2.8 5 4.5 5c2 0 2.4-4.4 3-7 .5-2 1.5-3.5 1.5-6 0-3-1.5-5-4-5-2 0-3 1-5 1S9 3 7 3z"/>',
  sparkle: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m12 8 1.5 2.5L16 12l-2.5 1.5L12 16l-1.5-2.5L8 12l2.5-1.5z"/>',
