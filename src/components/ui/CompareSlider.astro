---
// Before/after compare: drag (or use arrow keys on) the handle to wipe between the two photos.
// Without JavaScript it rests at a 50/50 split, which still shows both.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  alt: string;
  label: string;
  sizes?: string;
  focus?: string;
}
const { before, after, alt, label, sizes = '(min-width: 1024px) 760px, 100vw', focus = '50% 50%' } = Astro.props;
const widths = [480, 760, Math.min(after.width, 1090)].filter((w, i, a) => w <= after.width && a.indexOf(w) === i);
---
<div class="cmp" style={`--pos: 50%; --focus: ${focus}`} data-cmp>
  <Image src={after} alt={`After treatment: ${alt}`} widths={widths} sizes={sizes} class="cmp__img" />
  <div class="cmp__before">
    <Image src={before} alt={`Before treatment: ${alt}`} widths={widths} sizes={sizes} class="cmp__img" />
  </div>
  <span class="cmp__tag cmp__tag--before glass-strong">Before</span>
  <span class="cmp__tag cmp__tag--after glass-strong">After</span>
  <span class="cmp__handle" aria-hidden="true"><span></span></span>
  <input class="cmp__range" type="range" min="0" max="100" value="50" aria-label={`${label}: slide to compare before and after`} data-cmp-range />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('[data-cmp-range]');
    if (!range) return;
    const set = () => el.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>

<style>
  .cmp {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--mist);
    aspect-ratio: 856 / 411;
    user-select: none;
  }
  .cmp :global(.cmp__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
  }
  .cmp__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .cmp__tag {
    position: absolute;
    top: var(--space-3);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font: 600 var(--text-xs)/1.2 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    pointer-events: none;
  }
  .cmp__tag--before { left: var(--space-3); }
  .cmp__tag--after { right: var(--space-3); }
  .cmp__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--white);
    pointer-events: none;
  }
  .cmp__handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow-pill);
  }
  .cmp__handle span::before,
  .cmp__handle span::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 8px;
    height: 8px;
    border: solid var(--ink);
    border-width: 0 0 2px 2px;
  }
  .cmp__handle span::before { left: 11px; translate: 0 -50%; rotate: 45deg; }
  .cmp__handle span::after { right: 11px; translate: 0 -50%; rotate: -135deg; }
  .cmp__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .cmp:has(.cmp__range:focus-visible) {
    outline: 3px solid var(--brand-deep);
    outline-offset: 3px;
  }
</style>
