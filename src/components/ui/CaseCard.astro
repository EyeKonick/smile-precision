---
// One real before/after case: two photos with frosted labels, a title and a one-line note.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  note?: string;
  before: ImageMetadata;
  after: ImageMetadata;
  alt: string;
  focus?: string;
  /** stacked = before above after (wide photos); side = side by side (portrait photos) */
  layout?: 'stacked' | 'side';
  sizes?: string;
  /** override the photo aspect ratio, e.g. '3 / 2' */
  ratio?: string;
}
const { title, note, before, after, alt, focus = '50% 50%', layout = 'stacked', sizes = '(min-width: 1024px) 420px, 100vw', ratio } = Astro.props;
const w = (img: ImageMetadata) => [320, 480, img.width].filter((x, i, a) => x <= img.width && a.indexOf(x) === i);
---
<figure class={`case case--${layout}`} style={`--focus: ${focus};${ratio ? ` --ratio: ${ratio}` : ''}`}>
  <div class="case__pair">
    <div class="case__shot zoom">
      <Image src={before} alt={`Before: ${alt}`} widths={w(before)} sizes={sizes} loading="lazy" />
      <span class="case__tag glass-strong">Before</span>
    </div>
    <div class="case__shot zoom">
      <Image src={after} alt={`After: ${alt}`} widths={w(after)} sizes={sizes} loading="lazy" />
      <span class="case__tag glass-strong">After</span>
    </div>
  </div>
  <figcaption>
    <strong>{title}</strong>
    {note && <span>{note}</span>}
  </figcaption>
</figure>

<style>
  .case { margin: 0; display: grid; gap: var(--space-3); }
  .case__pair {
    display: grid;
    gap: 6px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .case--side .case__pair { grid-template-columns: 1fr 1fr; }
  .case__shot { position: relative; overflow: hidden; background: var(--mist); }
  .case--stacked .case__shot { aspect-ratio: var(--ratio, 2 / 1); }
  .case--side .case__shot { aspect-ratio: var(--ratio, 340 / 470); }
  .case__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
  }
  .case__tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    font: 600 0.6875rem/1.3 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  figcaption { display: grid; gap: 2px; }
  figcaption strong { font: 600 var(--text-md)/1.3 var(--font-display); }
  figcaption span { font-size: var(--text-sm); color: var(--ink-soft); }
</style>
