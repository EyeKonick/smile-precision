---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CaseCard from '../components/ui/CaseCard.astro';
import Icon from '../components/ui/Icon.astro';
import servicesData from '../data/services.json';
import { cases } from '../data/cases';
import { site } from '../data/site';
import veneerSet from '../../images/optimized/clinic-veneer-set.webp';
import whitening from '../../images/optimized/whitening-strip.webp';

type IconName = Parameters<typeof Icon>[0]['name'];
const byId = Object.fromEntries(cases.map((c) => [c.id, c]));

// Which real photo illustrates each service (only where the clinic has one).
const media: Record<string, { pair?: (typeof cases)[number]; image?: ImageMetadata; alt?: string }> = {
  'no-prep-veneers': { pair: byId['no-prep'] },
  'composite-veneers': { pair: byId['composite'] },
  'porcelain-veneers': { image: veneerSet, alt: 'A full arch of finished veneers on a dental model, held up in the clinic' },
  'laser-whitening': { image: whitening, alt: 'Patients during laser whitening with a blue protective gum barrier' },
  'smile-makeover': { pair: byId['face'] },
};

const groups = servicesData.categories.map((cat) => ({
  ...cat,
  services: servicesData.services.filter((s) => s.category === cat.id),
}));
const bookHref = (name: string) => `/contact?service=${encodeURIComponent(name)}#book`;
---
<BaseLayout title={`Services | Veneers, laser whitening & dental care | ${site.legalName}`} description="No-prep veneers, direct composite veneers, porcelain veneers, laser teeth whitening, smile makeovers and everyday dentistry at Smile Precision Dental Clinic, City of San Fernando, Pampanga.">
  <PageHeader
    eyebrow="Services"
    title="Treatments planned around"
    accent="you"
    lede="Veneers are our specialty, with everything around them to keep your smile healthy. Every treatment starts with a consultation and a plan you understand."
  >
    <nav class="jump" aria-label="Service categories">
      {groups.map((g) => <a class="jump__link glass" href={`#${g.id}`}>{g.name}</a>)}
      <a class="jump__link glass" href="#results">Real results</a>
    </nav>
  </PageHeader>

  {groups.map((g, gi) => (
    <section class:list={['grp section', { 'grp--alt': gi % 2 === 1 }]} id={g.id} aria-labelledby={`${g.id}-title`}>
      <div class="container grp__grid">
        <header class="grp__head">
          <span class="grp__n">0{gi + 1}</span>
          <h2 class="display grp__title" id={`${g.id}-title`}>{g.name}</h2>
          <p>{g.blurb}</p>
        </header>

        <div class="grp__list" data-stagger>
          {g.services.map((s) => {
            const m = media[s.slug];
            return (
              <article class:list={['svc glass', { 'svc--media': m }]} id={s.slug} data-reveal>
                {m?.pair && (
                  <CaseCard title="" before={m.pair.before} after={m.pair.after} alt={m.pair.alt} focus={m.pair.focus} layout="side" ratio={s.slug === 'smile-makeover' ? '340 / 470' : '3 / 2'} sizes="(min-width: 1024px) 220px, 45vw" />
                )}
                {m?.image && (
                  <div class:list={['svc__img', { 'svc__img--strip': m.image === whitening }]}>
                    <Image src={m.image} alt={m.alt ?? ''} widths={[440, m.image.width]} sizes="(min-width: 1024px) 440px, 90vw" loading="lazy" />
                  </div>
                )}
                <div class="svc__body">
                  {!m && <span class="svc__icon"><Icon name={s.icon as IconName} /></span>}
                  <h3>{s.name}</h3>
                  <p>{s.description}</p>
                  <a class="text-link" href={bookHref(s.name)} data-book-service={s.name}><span>Book this treatment</span><Icon name="arrow" /></a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <section class="all section bloom" id="results" aria-labelledby="results-title">
    <div class="container">
      <header class="all__head" data-reveal>
        <p class="eyebrow">Real results</p>
        <h2 class="display h2" id="results-title">Every case, from our own <span class="accent">patients</span></h2>
        <p class="lede">As shared on our Facebook page. Results differ from person to person.</p>
      </header>
      <div class="all__grid" data-stagger>
        {cases.map((c) => (
          <div class="all__item glass" data-reveal>
            <CaseCard title={c.title} note={c.note} before={c.before} after={c.after} alt={c.alt} focus={c.focus} layout={c.id === 'face' ? 'side' : 'stacked'} sizes="(min-width: 1024px) 400px, 92vw" />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .jump__link {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border-radius: var(--radius-pill); text-decoration: none;
    font: 600 var(--text-sm)/1 var(--font-display);
  }
  .jump__link:hover { background: var(--white); }

  .grp--alt { background: var(--mist); }
  .grp__grid { display: grid; gap: var(--space-6); }
  .grp__head { display: grid; gap: var(--space-3); align-content: start; }
  .grp__n { font: 300 var(--text-lg)/1 var(--font-display); color: var(--brand-deep); }
  .grp__title { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem); }
  .grp__head p { color: var(--ink-soft); max-width: 34ch; }

  .grp__list { display: grid; gap: var(--space-4); }
  .svc {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    scroll-margin-top: 120px;
  }
  .svc__body { display: grid; gap: var(--space-2); justify-items: start; align-content: center; }
  .svc__body h3 { font-size: var(--text-lg); }
  .svc__body p { color: var(--ink-soft); font-size: var(--text-sm); max-width: 54ch; }
  .svc__icon {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--white); color: var(--brand-deep); box-shadow: inset 0 0 0 1px var(--line);
    margin-bottom: var(--space-2);
  }
  .svc__icon :global(svg) { width: 22px; height: 22px; }
  .svc__img { border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 4 / 3; }
  .svc__img--strip { aspect-ratio: 906 / 194; align-self: center; }
  .svc__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .svc :global(figcaption) { display: none; }

  .all__head { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .all__grid { display: grid; gap: var(--space-4); }
  .all__item { padding: var(--space-3) var(--space-3) var(--space-4); border-radius: var(--radius-lg); }
  .all__item :global(figcaption) { padding-inline: var(--space-2); }

  @media (min-width: 720px) {
    .all__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .grp__grid { grid-template-columns: 4fr 8fr; gap: var(--space-8); }
    .grp__head { position: sticky; top: 120px; }
    .svc--media { grid-template-columns: 1fr 1fr; align-items: center; }
    .grp#general .grp__list { grid-template-columns: 1fr 1fr; }
    .all__grid { grid-template-columns: repeat(6, 1fr); }
    .all__item { grid-column: span 2; }
    .all__item:nth-child(-n + 2) { grid-column: span 3; }
  }
</style>
